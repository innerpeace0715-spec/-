{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "U-file",
  "version": "0.3.3",
  "identifier": "com.cybereun.filemoa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "U-file",
        "width": 1200,
        "height": 960,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "/storage/emulated/0/**",
            "/storage/*/**",
            "$HOME/**"
          ],
          "requireLiteralLeadingDot": true
        }
      },
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icon/smartfile-icon.png"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MTMwQzIzRTM1QTdFOEYKUldTUGZscmpJd3dUUjNjUHVETHZHLzFDREVxNEFtOHBiOXFpd2ljcG5VM1NWVFBNTjNzZ0c0YS8K",
      "endpoints": [
        "https://github.com/cybereun/FileMoa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
